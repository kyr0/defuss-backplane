{
  "name": "defuss-backplane",
  "version": "0.3.0",
  "description": "Local, unified low-level persistence and logic layer RPC service for application service backend and MCP agents.",
  "author": "Aron Homberg",
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.4.5",
  "engines": {
    "node": ">=26",
    "bun": ">=1.4.4"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    }
  },
  "bin": {
    "defuss-backplane": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "ARCH.md",
    "LICENSE",
    ".env.example"
  ],
  "scripts": {
    "build": "pkgroll --clean-dist --license=dist/THIRD-PARTY-LICENSES.txt",
    "lint": "oxlint --deny-warnings src tests scripts && tsc --noEmit && tsc -p tests && tsc -p scripts",
    "test": "bun test ./tests",
    "start": "node dist/cli.js"
  },
  "dependencies": {
    "defuss-brotli": "0.3.0",
    "defuss-dataview": "0.10.0",
    "defuss-dbsonl": "0.9.0",
    "defuss-dson": "1.5.1",
    "defuss-lexicalsearch": "0.4.0",
    "defuss-logs": "0.3.0",
    "defuss-mcp": "0.6.2",
    "defuss-o11y": "0.3.0",
    "defuss-rpc": "4.4.0",
    "defuss-scheduler": "0.2.0",
    "defuss-serve": "0.4.0",
    "defuss-vfs": "0.3.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@types/bun": "1.4.5",
    "@types/node": "^26.0.0",
    "defuss-db": "3.3.0",
    "oxlint": "1.94.0",
    "pkgroll": "^2.0.0",
    "playwright-core": "1.65.1",
    "typescript": "5.9.3"
  }
}
