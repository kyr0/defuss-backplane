API_KEY=
PORT=43127
BACKPLANE_DATA_DIR=./var/data
BACKPLANE_OTLP=0
# base64url of 32 random bytes; empty runs without auth and bot users. Back it up with the data root.
BACKPLANE_AUTH_MASTER_KEY=
# Origins besides loopback that scheduled RPC callbacks may call, comma-separated.
BACKPLANE_CALLBACK_ORIGINS=
# Read by the OpenTelemetry SDK when BACKPLANE_OTLP=1; the default is http://localhost:4318/v1/metrics.
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=
