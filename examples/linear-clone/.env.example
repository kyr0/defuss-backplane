# The app's own listener on 127.0.0.1.
PORT=43180
# The defuss-backplane daemon on 127.0.0.1, and its API_KEY as the bot key. Bun reads this file: it expands `$NAME`
# and cuts an unquoted value at `#`. A key with `$` or `#` goes in double quotes, with each `$` written as `\$`.
BACKPLANE_PORT=43127
BACKPLANE_API_KEY=
# The backplane tenant that holds the workspace.
WORKSPACE=vector
# The person whom "My issues", comments and the activity feed refer to, until user auth exists.
VIEWER=aron
# The IANA time zone whose calendar decides today, due dates and cycle days.
TIME_ZONE=UTC
# When the backplane calls the due digest and the cycle rollover, as cron in TIME_ZONE (6 fields add seconds).
DIGEST_CRON=0 9 * * *
ROLLOVER_CRON=0 0 * * 1
