# The app's own listener on 127.0.0.1.
PORT=43180
# The defuss-backplane daemon on 127.0.0.1, and the app's bot key: run `make bot APP=linear-clone` in the backplane's
# directory. Bun reads this file: it expands `$NAME` and cuts an unquoted value at `#`. A key with `$` or `#` goes in
# double quotes, with each `$` written as `\$`.
BACKPLANE_PORT=43127
BACKPLANE_API_KEY=
# The backplane tenant that holds the workspace, and that its people sign in to: letters, digits, - and _.
WORKSPACE=vector
# The origin the browser loads the app from; empty means http://127.0.0.1:$PORT.
PUBLIC_ORIGIN=
# cookie keeps the refresh token in an HttpOnly cookie; token hands it to the page, for WebKit over plain HTTP.
AUTH_MODE=cookie
# An agent's API key for `make mcp-config`: `make apikey AGENT=<name>` prints one. The app itself does not read it.
AGENT_API_KEY=
# The IANA time zone whose calendar decides today, due dates and cycle days.
TIME_ZONE=UTC
# When the backplane calls the due digest and the cycle rollover, as cron in TIME_ZONE (6 fields add seconds).
DIGEST_CRON=0 9 * * *
ROLLOVER_CRON=0 0 * * 1
