{
  "name": "linear-clone",
  "version": "0.1.0",
  "description": "An issue tracker in the style of Linear: a Bun app service on defuss-serve that keeps its data in defuss-backplane.",
  "author": "Aron Homberg",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.5",
  "scripts": {
    "build": "bun scripts/build.ts",
    "lint": "oxlint --deny-warnings src tests scripts && tsc --noEmit",
    "test": "bun test ./tests"
  },
  "dependencies": {
    "defuss-backplane": "file:./deps/defuss-backplane",
    "defuss-dom-router": "0.1.1",
    "defuss-i18n": "0.2.0",
    "defuss-logs": "0.3.0",
    "defuss-mcp": "0.6.2",
    "defuss-morph": "0.3.1",
    "defuss-query": "0.2.1",
    "defuss-rpc": "4.4.0",
    "defuss-serve": "0.4.0",
    "defuss-shadcn": "0.10.2",
    "lucide": "1.79.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@types/bun": "1.4.5",
    "monocart-coverage-reports": "3.2.1",
    "oxlint": "1.94.0",
    "playwright-core": "1.65.1",
    "typescript": "5.9.3"
  }
}
